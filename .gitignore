app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Stray launcher resources accidentally generated at the repo root.
# Real Android resources live in android/app/src/main/res/.
/drawable-*/
/mipmap-*/
/values/

# Firebase Android config is project-specific; keep it local and never commit it.
# See the "Firebase setup" section in README.md for how to supply your own.
/android/app/google-services.json

# Widget Preview related
.widget_preview/
